-- Loader tetap: script utama selalu diambil ulang dengan URL unik.
assert(type(loadstring) == "function", "[n4th] Executor tidak menyediakan loadstring setelah update.")
local scriptUrl = "https://raw.githubusercontent.com/ZennJxD/n4th/refs/heads/main/n4th-main.lua"
local httpService = game:GetService("HttpService")
local lastError = "respons kosong"

for attempt = 1, 3 do
    local requestUrl = scriptUrl .. "?update=" .. httpService:GenerateGUID(false)
    local ok, source = pcall(function() return game:HttpGet(requestUrl) end)
    if not ok then
        lastError = tostring(source)
    elseif type(source) ~= "string" or source:match("^%s*$") then
        lastError = "server mengirim respons kosong"
    elseif source:match("^%s*<") then
        lastError = "server mengirim halaman HTML, coba lagi nanti"
    else
        local fn, compileError = loadstring(source, "n4th-main")
        if not fn then
            error("[n4th] Script terbaru gagal dikompilasi: " .. tostring(compileError), 0)
        end
        -- Jalankan sekali; error script tidak memicu eksekusi ulang.
        local ran, result = xpcall(fn, function(err)
            if debug and type(debug.traceback) == "function" then
                return debug.traceback(tostring(err), 2)
            end
            return tostring(err)
        end)
        if not ran then
            local globals = (getgenv and getgenv()) or _G
            local session = globals.__n4thOpus
            local step = session and session.InitStep or "inisialisasi script"
            error("[n4th] Gagal saat " .. tostring(step) .. ":\n" .. tostring(result), 0)
        end
        return result
    end
    if attempt < 3 then task.wait(1) end
end

error("[n4th] Gagal mengambil update setelah 3 percobaan: " .. lastError, 0)
